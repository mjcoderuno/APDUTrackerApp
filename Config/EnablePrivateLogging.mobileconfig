<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadDescription</key>
            <string>Enables raw hex payloads in Unified Logging for SmartCard and Biometric daemons.</string>
            <key>PayloadDisplayName</key>
            <string>BioCard APDU Unmasked Logging</string>
            <key>PayloadIdentifier</key>
            <string>com.biocard.logging.private</string>
            <key>PayloadType</key>
            <string>com.apple.system.logging</string>
            <key>PayloadUUID</key>
            <string>87B64BE8-5089-4D2A-B90F-23097FE8D251</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>System</key>
            <dict>
                <key>Enable-Private-Data</key>
                <true/>
            </dict>
            <key>Subsystems</key>
            <dict>
                <key>com.apple.CryptoTokenKit</key>
                <dict>
                    <key>DEFAULT-OPTIONS</key>
                    <dict>
                        <key>Enable-Private-Data</key>
                        <true/>
                        <key>Level</key>
                        <dict>
                            <key>Enable</key>
                            <string>Debug</string>
                            <key>Persist</key>
                            <string>Debug</string>
                        </dict>
                    </dict>
                </dict>
                <key>com.apple.AuthenticationServices</key>
                <dict>
                    <key>DEFAULT-OPTIONS</key>
                    <dict>
                        <key>Enable-Private-Data</key>
                        <true/>
                    </dict>
                </dict>
            </dict>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>BioCard Private Logging Profile</string>
    <key>PayloadIdentifier</key>
    <string>com.biocard.profile</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
